{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@business-operations/run-client": ["../packages/run-client/src/index.ts"],
      // The package's tests run on this project's vitest, and node resolution from a
      // sibling directory with no `node_modules` of its own never reaches this install.
      "vitest": ["./node_modules/vitest"]
    }
  },
  // The sibling package is listed as well as aliased: the alias alone reaches only the
  // modules `src` imports, which leaves its tests unchecked — and they were checked here,
  // as frontend files, before they moved out. `test` is listed for the same reason: the
  // drift guards read repo files instead of importing them, so nothing else pulls them in.
  //
  // No `exclude`. It used to hold `src/test`, which quietly meant the ten files in there
  // were the only ones in the project tsc never looked at — three `@ts-expect-error`
  // directives that suppressed nothing had accumulated behind it.
  "include": ["src", "test", "../packages/run-client/src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
