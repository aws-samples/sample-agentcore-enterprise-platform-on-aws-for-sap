{
  "$schema": "../pack.schema.json",
  "pack_id": "finance_ops",
  "display_name": "Finance — Accounts Payable",
  "description": "Procure-to-pay exception resolution: three-way matching, price/quantity variances, missing documents, duplicate invoices.",
  "model_tier": "haiku",
  "max_turns": 15,
  "sap_service": {
    "services": [
      {
        "service": "API_SUPPLIERINVOICE_PROCESS_SRV",
        "entities": {
          "supplier_invoice": {
            "name": "A_SupplierInvoice",
            "fields": [
              "SupplierInvoice",
              "FiscalYear",
              "CompanyCode",
              "DocumentDate",
              "PostingDate",
              "CreationDate",
              "SupplierInvoiceIDByInvcgParty",
              "InvoicingParty",
              "DocumentCurrency",
              "InvoiceGrossAmount",
              "UnplannedDeliveryCost",
              "DocumentHeaderText",
              "PaymentTerms",
              "PaymentBlockingReason",
              "SupplierInvoiceStatus",
              "ReverseDocument"
            ]
          },
          "supplier_invoice_item": {
            "name": "A_SuplrInvcItemPurOrdRef",
            "fields": [
              "SupplierInvoice",
              "FiscalYear",
              "SupplierInvoiceItem",
              "PurchaseOrder",
              "PurchaseOrderItem",
              "Plant",
              "TaxCode",
              "DocumentCurrency",
              "SupplierInvoiceItemAmount",
              "QuantityInPurchaseOrderUnit",
              "SupplierInvoiceItemText"
            ]
          }
        },
        "function_imports": {
          "Release": {
            "params": [
              {
                "name": "SupplierInvoice",
                "type": "Edm.String",
                "required": true
              },
              {
                "name": "FiscalYear",
                "type": "Edm.String",
                "required": true
              },
              {
                "name": "DiscountDaysHaveToBeShifted",
                "type": "Edm.Boolean",
                "required": false,
                "default": "false"
              }
            ]
          },
          "Post": {
            "params": [
              {
                "name": "SupplierInvoice",
                "type": "Edm.String",
                "required": true
              },
              {
                "name": "FiscalYear",
                "type": "Edm.String",
                "required": true
              }
            ]
          },
          "Cancel": {
            "params": [
              {
                "name": "SupplierInvoice",
                "type": "Edm.String",
                "required": true
              },
              {
                "name": "FiscalYear",
                "type": "Edm.String",
                "required": true
              },
              {
                "name": "PostingDate",
                "type": "Edm.DateTime",
                "required": true,
                "note": "OData V2 URI literal datetime'YYYY-MM-DDT00:00:00' (not /Date(ms)/, quoted or not); the original invoice's own PostingDate per short_pay 3.1"
              },
              {
                "name": "ReversalReason",
                "type": "Edm.String",
                "required": true,
                "note": "Two-character reason code, quoted: '01' unless the operator configured another (short_pay 3.2)"
              }
            ]
          }
        }
      },
      {
        "service": "API_PURCHASEORDER_PROCESS_SRV",
