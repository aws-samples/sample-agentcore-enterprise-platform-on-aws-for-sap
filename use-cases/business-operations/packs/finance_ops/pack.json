              "ManufacturingOrder",
              "ManufacturingOrderItem",
              "GoodsMovementRefDocType",
              "GoodsMovementReasonCode",
              "Delivery",
              "DeliveryItem",
              "AccountAssignmentCategory",
              "CostCenter",
              "ControllingArea",
              "CostObject",
              "GLAccount",
              "FunctionalArea",
              "ProfitabilitySegment",
              "ProfitCenter",
              "MasterFixedAsset",
              "FixedAsset",
              "MaterialBaseUnit",
              "QuantityInBaseUnit",
              "EntryUnit",
              "QuantityInEntryUnit",
              "CompanyCodeCurrency",
              "GdsMvtExtAmtInCoCodeCrcy",
              "SlsPrcAmtInclVATInCoCodeCrcy",
              "FiscalYear",
              "FiscalYearPeriod",
              "FiscalYearVariant",
              "IssgOrRcvgMaterial",
              "IssgOrRcvgBatch",
              "IssuingOrReceivingPlant",
              "IssuingOrReceivingStorageLoc",
              "IssuingOrReceivingStockType",
              "IssgOrRcvgSpclStockInd",
              "IssuingOrReceivingValType",
              "IsCompletelyDelivered",
              "MaterialDocumentItemText",
              "GoodsRecipientName",
              "UnloadingPointName",
              "ShelfLifeExpirationDate",
              "ManufactureDate",
              "SerialNumbersAreCreatedAutomly",
              "Reservation",
              "ReservationItem",
              "ReservationIsFinallyIssued",
              "SpecialStockIdfgSalesOrder",
              "SpecialStockIdfgSalesOrderItem",
              "SpecialStockIdfgWBSElement",
              "IsAutomaticallyCreated",
              "MaterialDocumentLine",
              "MaterialDocumentParentLine",
              "HierarchyNodeLevel",
              "GoodsMovementIsCancelled",
              "ReversedMaterialDocumentYear",
              "ReversedMaterialDocument",
              "ReversedMaterialDocumentItem",
              "ReferenceDocumentFiscalYear",
              "InvtryMgmtRefDocumentItem",
              "InvtryMgmtReferenceDocument",
              "MaterialDocumentPostingType",
              "InventoryUsabilityCode",
              "EWMWarehouse",
              "EWMStorageBin",
              "DebitCreditCode",
              "StockSegment",
              "IssgOrRcvgStockSegment"
            ]
          }
        }
      }
    ]
  },
  "entitlement": {
    "groups": [
      "business-operations-ap-clerk",
      "business-operations-ap-manager"
    ],
    "approve_groups": [
      "business-operations-ap-manager"
    ]
  },
  "constants": {
    "QTY_VARIANCE_PCT": 5,
    "QTY_VARIANCE_UNITS": 10,
    "PRICE_VARIANCE_PCT": 2,
    "PRICE_VARIANCE_ABS_USD": 0.5,
    "LINE_AMOUNT_TOLERANCE_USD": 100,
    "DUPLICATE_MATCH_WINDOW_USD": 100,
    "MISSING_GR_ESCALATION_DAYS": 5,
    "GOODS_IN_TRANSIT_REMINDER_DAYS": 3,
    "SHORT_PAY_DISPUTE_WINDOW_DAYS": 30,
    "AUTO_WRITE_LIMIT_USD": 100000,
    "DUAL_APPROVAL_LIMIT_USD": 250000
  },
  "gateway_tools": [
    "business-operations-case-management___get_case_state",
    "business-operations-case-management___update_case_state",
    "sap-s4___odata_function_import",
    "business-operations-knowledge___search_sap_sops",
    "business-operations-knowledge___search_sap_api_docs",
    "business-operations-sops___load_sop",
    "business-operations-notification___send_notification",
    "business-operations-tickets___demo_create_ticket",
    "business-operations-tickets___demo_get_ticket",
    "sap-s4___odata_read",
    "sap-s4___odata_count",
    "business-operations-agent-knowledge___get_precedent"
  ],
  "write_guards": [
    "po_reference",
    "no_duplicate",
    "gr_coverage",
    "within_tolerance_or_approved"
  ],
  "case_document_check": {
    "SupplierInvoice": "SupplierInvoice",
    "FiscalYear": "FiscalYear"
  },
  "write_amount_field": "InvoiceGrossAmount",
  "verifier": {
    "enabled": false,
    "model_tier": "haiku",
    "guidance": "On a price or quantity variance approval ticket, Approve means release as billed. That holds for a quantity variance even though the goods receipt shows fewer units than billed: the approver accepted exactly that difference. A Deny whose comment asks to pay only what the purchase order and goods receipt support is the answer short pay, not a refusal to write: it routes to the short_pay SOP. A Deny that says the invoice must be corrected to the PO price, or that the overcharge must be disputed with the supplier, asks for the same thing and is also short pay. This service has no partial-payment write, so a short pay is executed by Cancel on the blocked invoice with a reversal reason, and the supplier reissues for the supported amount. So after such a Deny, a Cancel of the whole invoice is the expected write and a Release is wrong. Any other Deny means no write: manual review. A Release after a short-pay Deny, or any write after a plain Deny, is a contradiction. A Cancel is correct only when a ticket on this case answered short pay, or approved the Cancel itself; a Cancel with no such ticket, or after an approval in full, is a contradiction."
  },
  "process_type_to_sop": {
    "price_variance": "finance_ops/price_variance.txt",
    "quantity_variance": "finance_ops/quantity_variance.txt",
    "uom_mismatch": "finance_ops/uom_mismatch.txt",
    "missing_goods_receipt": "finance_ops/missing_goods_receipt.txt",
    "missing_purchase_order": "finance_ops/missing_purchase_order.txt",
    "duplicate_invoice": "finance_ops/duplicate_invoice.txt",
    "short_pay": "finance_ops/short_pay.txt",
    "invoice_matching": "finance_ops/invoice_matching.txt",
    "three_way_match": "finance_ops/invoice_matching.txt",
    "ap_exception": "finance_ops/invoice_matching.txt"
  },
  "shared_sops": [
    "short_pay"
  ],
  "dispositions": [
    "released",
    "already_released",
    "rejected_duplicate",
    "cancelled_for_reissue",
    "release_refused",
    "escalated"
  ],
  "source": {
    "label": "AP invoice exceptions",
    "kind": "filter",
    "push": "nudge",
    "service": "API_SUPPLIERINVOICE_PROCESS_SRV",
    "entity": "A_SupplierInvoice",
    "filter": "PaymentBlockingReason ne '' and ReverseDocument eq ''",
    "created_field": "CreationDate",
    "expand": "to_SuplrInvcItemPurOrdRef",
    "select": "SupplierInvoice,FiscalYear,CompanyCode,DocumentDate,PostingDate,InvoicingParty,InvoiceGrossAmount,DocumentCurrency,PaymentBlockingReason,SupplierInvoiceStatus,SupplierInvoiceIDByInvcgParty,to_SuplrInvcItemPurOrdRef",
    "short_id": "ap",
    "key": [
      {
        "field": "SupplierInvoice",
        "source": "parent",
        "strip": true,
        "as": "document_number"
      },
      {
        "field": "FiscalYear",
        "source": "parent",
        "strip": true,
        "fallback": "0001",
        "as": "item_id"
      }
    ],
    "iterate": {
      "path": "to_SuplrInvcItemPurOrdRef"
    },
    "skip_when": [
      {
        "field": "SupplierInvoice",
        "op": "blank",
        "scope": "parent"
      }
    ],
    "process_type": {
      "default": "invoice_matching"
    },
    "title": "Invoice {parent.SupplierInvoice} / FY {parent.FiscalYear} — Block: {parent.PaymentBlockingReason} ({parent.DocumentCurrency} {abs_amount})",
    "field_map": {
      "supplier_number": {
        "path": "parent.InvoicingParty"
      },
      "amount": {
        "path": "parent.InvoiceGrossAmount",
        "cast": "abs_decimal"
      },
      "currency": {
        "path": "parent.DocumentCurrency"
      },
      "sap_block_reason": {
        "path": "parent.PaymentBlockingReason"
      },
      "invoice_status": {
        "path": "parent.SupplierInvoiceStatus"
      },
      "company_code": {
        "path": "parent.CompanyCode"
      },
      "document_date": {
        "path": "parent.DocumentDate",
        "cast": "sap_date"
      },
      "posting_date": {
        "path": "parent.PostingDate",
        "cast": "sap_date"
      },
      "external_reference": {
        "path": "parent.SupplierInvoiceIDByInvcgParty"
      },
      "purchase_order": {
        "path": "child.PurchaseOrder",
        "strip": true,
        "omit_blank": true
      },
      "po_line_item": {
        "path": "child.PurchaseOrderItem",
        "strip": true,
        "omit_blank": true
      },
      "invoice_quantity": {
        "path": "child.QuantityInPurchaseOrderUnit",
        "cast": "abs_decimal",
        "omit_blank": true
      }
    }
  },
  "fields": {
    "supplier_number": {
      "label": "Supplier",
      "type": "string"
    },
    "amount": {
      "label": "Amount",
      "type": "amount",
      "currency_field": "currency"
    },
    "currency": {
      "label": "Currency",
      "type": "string"
    },
    "sap_block_reason": {
      "label": "SAP block reason",
      "type": "string",
      "role": "reason"
    },
    "invoice_status": {
      "label": "Invoice status",
      "type": "string",
      "panel": false
    },
    "document_date": {
      "label": "Document date",
      "type": "date"
    },
    "posting_date": {
      "label": "Posting date",
      "type": "date"
    },
    "external_reference": {
      "label": "External reference",
      "type": "string"
    },
    "company_code": {
      "label": "Company code",
      "type": "string"
    },
    "purchase_order": {
      "label": "Purchase order",
      "type": "string",
      "panel": false
    },
    "po_line_item": {
      "label": "PO line item",
      "type": "string",
      "panel": false
    },
    "invoice_quantity": {
      "label": "Invoice quantity",
      "type": "decimal",
      "panel": false
    }
  },
  "seed": {
    "label": "AP three-way match",
    "summary": "Posts a purchase order, a goods receipt against it, and a blocked supplier invoice. S/4HANA sample data, company code 1710.",
    "company_code": "1710",
    "sap_state": {
      "service": "FAP_VENDOR_LINE_ITEMS_SRV",
      "entity": "Items",
      "filter": "CompanyCode eq '1710' and OriginalReferenceDocument eq '{{SupplierInvoice + FiscalYear}}'"
    },
    "inputs": [
      {
        "id": "po_amount",
        "label": "PO amount (USD)",
        "type": "number",
        "default": 50000,
        "min": 1
      },
      {
        "id": "invoice_amount",
        "label": "Invoice amount (USD)",
        "type": "number",
        "default": 52500,
        "min": 1
      },
      {
        "id": "skip_gr",
        "label": "Skip goods receipt",
        "type": "boolean",
        "default": false,
        "hint": "Creates a missing goods receipt scenario"
      },
      {
        "id": "po_quantity",
        "label": "PO quantity",
        "type": "number",
        "default": 10,
        "min": 1,
        "hint": "Ordered"
      },
      {
        "id": "gr_quantity",
        "label": "GR quantity",
        "type": "number",
        "default": 10,
        "min": 0,
        "hint": "Received",
        "disabled_when": "skip_gr"
      },
      {
        "id": "invoice_quantity",
        "label": "Invoice quantity",
        "type": "number",
        "default": 10,
        "min": 1,
        "hint": "Invoiced"
      },
      {
        "id": "payment_block",
        "label": "Payment block",
        "type": "select",
        "default": "R",
        "options": [
          {
            "value": "R",
            "label": "R — Invoice verification"
          },
          {
            "value": "B",
            "label": "B — Manual payment block"
          }
        ]
      },
      {
        "id": "posting_date",
        "label": "Posting date",
        "type": "string",
        "default": "",
        "hint": "YYYY-MM-DD, in a period open in SAP; blank reads the latest open date from SAP (Basic sign-in only)"
      }
    ],
    "presets": [
      {
        "label": "Exact 3-way match — PO, GR and invoice agree",
        "values": {
          "po_amount": 25000,
          "invoice_amount": 25000,
          "payment_block": "R",
          "skip_gr": false,
          "po_quantity": 10,
          "invoice_quantity": 10,
          "gr_quantity": 10
        }
      },
      {
        "label": "Price variance 5% — over-invoiced",
        "values": {
          "po_amount": 50000,
          "invoice_amount": 52500,
          "payment_block": "R",
          "skip_gr": false,
          "po_quantity": 10,
          "invoice_quantity": 10,
          "gr_quantity": 10
        }
      },
      {
        "label": "Quantity variance — invoiced 12, received 10",
        "values": {
          "po_amount": 50000,
          "invoice_amount": 50000,
          "payment_block": "R",
          "skip_gr": false,
          "po_quantity": 10,
          "invoice_quantity": 12,
          "gr_quantity": 10
        }
      },
      {
        "label": "Missing goods receipt — no GR posted",
        "values": {
          "po_amount": 40000,
          "invoice_amount": 40000,
          "payment_block": "R",
          "skip_gr": true,
          "po_quantity": 10,
          "invoice_quantity": 10,
          "gr_quantity": 10
        }
      },
      {
        "label": "Under-invoiced — partial delivery",
        "values": {
          "po_amount": 75000,
          "invoice_amount": 60000,
          "payment_block": "R",
          "skip_gr": false,
          "po_quantity": 10,
          "invoice_quantity": 8,
          "gr_quantity": 8
        }
      },
      {
        "label": "Manual payment block — exact match",
        "values": {
          "po_amount": 40000,
          "invoice_amount": 40000,
          "payment_block": "B",
          "skip_gr": false,
          "po_quantity": 5,
          "invoice_quantity": 5,
          "gr_quantity": 5
        }
      },
      {
        "label": "Over the auto-write limit — exact match, needs a human anyway",
        "values": {
          "po_amount": 150000,
          "invoice_amount": 150000,
          "payment_block": "R",
          "skip_gr": false,
          "po_quantity": 10,
          "invoice_quantity": 10,
          "gr_quantity": 10
        }
      }
    ],
    "steps": [
      {
        "id": "po",
        "label": "Purchase order",
        "service": "API_PURCHASEORDER_PROCESS_SRV",
        "entity": "A_PurchaseOrder",
        "payload": {
          "PurchaseOrderType": "NB",
          "Supplier": "USSU-VSF04",
          "PurchasingOrganization": "1710",
          "PurchasingGroup": "002",
          "CompanyCode": "1710",
          "DocumentCurrency": "USD",
          "PaymentTerms": "0002",
          "Language": "EN",
          "to_PurchaseOrderItem": [
            {
              "PurchaseOrderItem": "10",
              "Material": "MZ-RM-R300-01",
              "OrderQuantity": "{{po_quantity}}",
              "PurchaseOrderQuantityUnit": "PC",
              "NetPriceAmount": "{{round(po_amount / po_quantity, 2)}}",
              "Plant": "1710",
              "MaterialGroup": "ZFRAME",
              "AccountAssignmentCategory": "K",
              "GoodsReceiptIsExpected": true,
              "InvoiceIsExpected": true,
              "to_AccountAssignment": [
                {
                  "AccountAssignmentNumber": "1",
                  "CostCenter": "17100100"
                }
              ]
            }
          ]
        },
        "returns": {
          "po_number": "PurchaseOrder"
        }
      },
      {
        "id": "gr",
        "label": "Goods receipt (movement 101)",
        "when": "not skip_gr",
        "service": "API_MATERIAL_DOCUMENT_SRV",
        "entity": "A_MaterialDocumentHeader",
        "payload": {
          "GoodsMovementCode": "01",
          "DocumentDate": "{{sap_date(posting_date, -7)}}",
          "PostingDate": "{{sap_date(posting_date)}}",
          "MaterialDocumentHeaderText": "GR for PO {{po.PurchaseOrder}}",
          "to_MaterialDocumentItem": {
            "results": [
              {
                "Material": "MZ-RM-R300-01",
                "Plant": "1710",
                "StorageLocation": "171A",
                "GoodsMovementType": "101",
                "PurchaseOrder": "{{po.PurchaseOrder}}",
                "PurchaseOrderItem": "10",
                "GoodsMovementRefDocType": "B",
                "QuantityInEntryUnit": "{{gr_quantity}}",
                "EntryUnit": "PC"
              }
            ]
          }
        },
        "returns": {
          "gr_document": "MaterialDocument"
        }
      },
      {
        "id": "invoice",
        "label": "Supplier invoice, blocked",
        "service": "API_SUPPLIERINVOICE_PROCESS_SRV",
        "entity": "A_SupplierInvoice",
        "payload": {
          "SupplierInvoice": "",
          "FiscalYear": "{{year(posting_date)}}",
          "CompanyCode": "1710",
          "DocumentDate": "{{sap_date(posting_date, -14)}}",
          "PostingDate": "{{sap_date(posting_date)}}",
          "SupplierInvoiceIDByInvcgParty": "INV-{{po.PurchaseOrder}}",
          "InvoicingParty": "USSU-VSF04",
          "DocumentCurrency": "USD",
          "InvoiceGrossAmount": "{{invoice_amount}}",
          "PaymentBlockingReason": "{{payment_block}}",
          "to_SuplrInvcItemPurOrdRef": [
            {
              "SupplierInvoiceItem": "1",
              "PurchaseOrder": "{{po.PurchaseOrder}}",
              "PurchaseOrderItem": "10",
              "Plant": "1710",
              "TaxCode": "",
              "DocumentCurrency": "USD",
              "SupplierInvoiceItemAmount": "{{invoice_amount}}",
              "PurchaseOrderQuantityUnit": "PC",
              "QuantityInPurchaseOrderUnit": "{{invoice_quantity}}"
            }
          ]
        },
        "returns": {
          "invoice_number": "SupplierInvoice",
          "fiscal_year": "FiscalYear"
        }
      }
    ],
    "case": {
      "key": {
        "SupplierInvoice": "{{invoice.SupplierInvoice}}",
        "FiscalYear": "{{invoice.FiscalYear}}"
      },
