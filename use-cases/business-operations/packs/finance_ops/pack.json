            ]
          },
          "goods_receipt_item": {
            "name": "A_MaterialDocumentItem",
            "fields": [
              "MaterialDocumentYear",
              "MaterialDocument",
              "MaterialDocumentItem",
              "Material",
              "Plant",
              "StorageLocation",
              "Batch",
              "GoodsMovementType",
              "InventoryStockType",
