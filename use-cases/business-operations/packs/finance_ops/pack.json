        "entities": {
          "goods_receipt": {
            "name": "A_MaterialDocumentHeader",
            "fields": [
              "MaterialDocumentYear",
              "MaterialDocument",
              "InventoryTransactionType",
              "DocumentDate",
              "PostingDate",
              "CreationDate",
              "CreationTime",
              "CreatedByUser",
              "MaterialDocumentHeaderText",
              "ReferenceDocument",
              "VersionForPrintingSlip",
              "ManualPrintIsTriggered",
              "CtrlPostgForExtWhseMgmtSyst",
