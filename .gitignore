*.swp
package-lock.json
__pycache__
.pytest_cache
.venv
*.egg-info
dist
.cdk.staging
cdk.out
node_modules
.DS_Store
.env
.cdk-placeholder
cdk.context.json

# Local-only deployment tracker
DEPLOYMENTS.md

# Saved workshop discovery answers (per-user, regenerated by deploy.sh)
workshop.env
# The deployment manifest is per-deployment (often generated from a preset by
# --profile). Committing yours is a deliberate act: git add -f platform.yaml
platform.yaml

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
deploy.log
*.tfvars
!*.tfvars.example
.terraform.lock.hcl
override.tf
override.tf.json

# Dashboard monitor output (account-specific, auto-generated)
dashboard/public/status.json

# Local, account-specific export snapshots
workshop-outputs-*.json

.vscode/
.playwright-cli/

# Kiro session steering (local-only, must never ship). The skills directory is the
# exception: it holds only symlinks to the shipped skills, so Kiro finds them in a clone.
.kiro/*
!.kiro/skills/

# Local git worktrees (parallel branches checked out inside the repo)
.worktrees/

# --- Fork additions ---------------------------------------------------------
# GitLab CI's pip and npm caches live inside the checkout
.cache

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Security scanner output: the reports quote whatever secret material they found.
.ash/
.protoshield/
.ruff_cache/
.idea/
.env.*
!.env.example

# Agent tooling scratch, never shipped
.claude/settings.local.json
.claude/worktrees/
.superpowers/
.playwright-mcp/
.scratch-*
graphify-out/
GRAPH_REPORT.md

# Beads: the Dolt database is the record and syncs via refs/dolt/data (bd dolt push).
# A tracked export is what made every worktree fight over one file.
.beads/issues.jsonl
# Use cases are drop-ins: one copied in with `deploy.sh usecase add` stays out of git.
# The shipped ones are listed; `deploy.sh usecase new` lists each one it creates, and
# `usecase remove` takes its line out again.
use-cases/*
!use-cases/README.md
!use-cases/_template/
!use-cases/business-operations/
!use-cases/claude-3p-on-bedrock/
!use-cases/hello-platform/
!use-cases/hello-sap/
# What `usecase add` saves before it rewrites platform.yaml.
platform.yaml.*.bak
# --- End fork additions -----------------------------------------------------
